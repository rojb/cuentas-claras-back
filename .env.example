# Copy this file to .env and fill it in. NEVER commit .env.
DATABASE_URL=postgres://splitter:splitter@localhost:55432/splitter

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

JWT_EXPIRES_IN_SECONDS=604800
PORT=3000

# Browser origins allowed to read this API's answers, comma-separated.
# A trailing `:*` accepts any port on that host, which is what a local
# `flutter run -d chrome` needs. Set the real origins when deploying.
# WEB_ORIGINS=http://localhost:*,http://127.0.0.1:*
