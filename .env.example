# Copy this file to .env and fill it in. NEVER commit .env.
DATABASE_URL=postgres://splitter:splitter@localhost:55432/splitter

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

JWT_EXPIRES_IN_SECONDS=604800
PORT=3000

# Browser origins allowed to read this API's answers, comma-separated.
# A trailing `:*` accepts any port on that host, which is what a local
# `flutter run -d chrome` needs. Set the real origins when deploying.
# WEB_ORIGINS=http://localhost:*,http://127.0.0.1:*

# The expense and payment forms fill "tipo de cambio" from Binance P2P so it
# does not have to be typed. These defaults work as-is; set BINANCE_P2P_URL
# only to point the fetch somewhere else in a test.
# BINANCE_P2P_URL=https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search
# RATE_CACHE_TTL_SECONDS=300
# RATE_FETCH_TIMEOUT_MS=10000
